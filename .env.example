# Supabase (required — auth + analytics + Google tokens)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI providers (optional — users can provide their own keys via Settings)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Google OAuth (Calendar + YouTube — same credentials)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   https://your-domain.com/api/auth/google/callback
#   https://your-domain.com/api/auth/youtube/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Meta (Instagram + Facebook)
# Create at https://developers.facebook.com/apps
# Valid OAuth Redirect URI: https://your-domain.com/api/auth/meta/callback
META_APP_ID=
META_APP_SECRET=

# TikTok
# Create at https://developers.tiktok.com/apps
# Redirect URI: https://your-domain.com/api/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn
# Create at https://www.linkedin.com/developers/apps
# Authorized redirect URL: https://your-domain.com/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Admin code for /integrations-guide page (set any strong string you'll remember)
INTEGRATIONS_GUIDE_CODE=
