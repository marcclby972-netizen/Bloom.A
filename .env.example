# Supabase (required — auth + analytics + Google tokens)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI providers (optional — users can provide their own keys via Settings)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Google OAuth (optional — for Google Calendar integration)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
